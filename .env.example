# ============================================================
# AVANI AGRO FOODS WEBSITE ENGINE — ENVIRONMENT CONFIGURATION TEMPLATE
# .env.example
# Package 3F.108 Standardized Configuration Reference
# IMPORTANT: Provide cryptographically strong secrets in production.
# Never commit real credentials, production tokens, or sensitive values.
# ============================================================

# ── 1. SESSION & AUTHENTICATION SECRETS ──────────────────────
# Mandatory 256-bit secret used to HMAC-sign session cookies and CSRF tokens.
# Minimum 32 random characters recommended. Must fail-closed if missing.
SESSION_SECRET=your-random-session-secret-min-32-characters

# Primary administrative password for Master Gate access (/private, /admin).
# Note: Legacy alias PRIVATE_PORTAL_PASSWORD is supported but deprecated.
MASTER_GATE_PASSWORD=your-secure-master-gate-password

# Dedicated password for Affiliate Programme portal (/affiliate-login).
# Note: Legacy alias AFFILIATE_PASSWORD is supported as a fallback.
AFFILIATE_PORTAL_PASSWORD=your-secure-affiliate-portal-password

# Optional programmatic API key for trusted machine-to-machine admin integration.
ADMIN_API_KEY=your-random-admin-api-key

# Secret token required to trigger automated sequence crons (/api/cron-sequence-dispatch).
CRON_SECRET=your-random-cron-dispatch-secret

# ── 2. DISTRIBUTED STORAGE & RATE LIMITING (UPSTASH / REDIS) ─
# Set to 1 to mandate distributed KV in production for sessions and rate-limiting.
# If set to 1 and credentials are unavailable, authentication fails closed (503).
REQUIRE_DISTRIBUTED_KV=1

# Upstash Redis / Vercel KV REST API connection endpoint.
KV_REST_API_URL=https://your-database-id.upstash.io
# Supported alias: UPSTASH_REDIS_REST_URL=https://your-database-id.upstash.io

# Upstash Redis / Vercel KV REST API read-write authorization token.
KV_REST_API_TOKEN=your-upstash-rest-token
# Supported alias: UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ── 3. CORS & ORIGIN ALLOWLIST ──────────────────────────────
# Comma-separated list of exact allowed origins for state-changing browser mutations.
# Local development ports are automatically permitted in non-production runtimes.
ALLOWED_ORIGINS=https://www.avaniagrofoods.com,https://avaniagrofoods.com

# ── 4. WEBHOOK & EXTERNAL SERVICES ──────────────────────────
# Secret key used to verify Resend / Svix delivery and reply webhook signatures.
# Starts with 'whsec_' as provided in the Resend Webhook Dashboard.
RESEND_WEBHOOK_SECRET=whsec_your-resend-svix-webhook-secret

# API key for Resend email dispatch engine.
RESEND_API_KEY=re_your_resend_api_key

# ── 5. SAFETY GATES & INVARIANTS ────────────────────────────
# Global emergency halt: set to 1 to block all external email dispatch.
GLOBAL_OUTREACH_STOP=1

# Operational authorization: must be 1 to enable outbound buyer communications.
OUTREACH_AUTHORIZED=0

# Safety gate: set to 1 only when live buyer email delivery is permitted.
REAL_BUYER_EMAILS=0

# Controlled B2B pilot outreach gate (0=locked, 1=enabled for verified contacts).
PILOT_AUTHORIZED=0

# Shared HMAC secret for signed Project A <-> Project B ecosystem event synchronization.
ECOSYSTEM_SYNC_SECRET=your-random-ecosystem-sync-secret-min-32-chars

# ── 6. DATABASE (SUPABASE) ──────────────────────────────────
# Supabase project REST URL for persistent lead and audit storage.
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Service Role Key (Server-side only — never expose to client bundles).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
